API_KEY=
OPENROUTER_API_KEY=
CHAT_MODEL=openrouter/inception/mercury-2.5
E2E_MODEL=openrouter/inception/mercury-2.5
# Optional OpenAI-compatible endpoint for E2E act/assert. When set, E2E_API_KEY is optional.
E2E_BASE_URL=
E2E_API_KEY=
E2E_TELEMETRY_DISABLED=1
# Docker starts OpenCode inside the server container; native runs can use a host `opencode serve`.
OPENCODE_BASE_URL=http://127.0.0.1:4096
# Docker bind-mount source for OpenCode config/agents. OpenCode auth data lives under /data in Docker.
OPENCODE_CONFIG_PATH=./opencode-config
# Optional basic auth for a protected OpenCode server.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Optional explicit Claude Code configuration directory. Otherwise ~/.claude is used.
CLAUDE_CONFIG_DIR=
# Claude Agent SDK remote authentication (kept server-side).
ANTHROPIC_API_KEY=
PORT=3000
MCP_PORT=3001
SERVER_URL=http://localhost:3000
WEB_URL=http://localhost:5173
POSTGRES_PASSWORD=agent
# Used when running the API directly on the host. Docker Compose overrides it with db:5432.
DATABASE_URL=postgres://agent:agent@127.0.0.1:5432/agent_tester
DB_POOL_SIZE=10
# Master key for Jira API tokens (32 random bytes as base64); keep stable/backed up, never commit it.
JIRA_ENCRYPTION_KEY=
# Laya Browser Code Mode MCP (launches one MCP process/session per run).
# Example: node /path/to/laya-browser/bin/laya-browser-mcp.mjs
LAYA_MCP_COMMAND=
LAYA_MCP_ARGS=[]
LAYA_MCP_CWD=
# Optional JSON overrides passed to the MCP process; secrets stay in this server-side environment.
# LAYA_MCP_ENV={"JEV_BACKEND":"jev","JEV_MODEL":"jev-latest"}
# Laya's MCP process also receives JEV_* and TypeSafe/OpenRouter keys from the server environment.
# Configure JEV_BACKEND=jev or JEV_BACKEND=laya independently of E2E_BASE_URL/E2E_MODEL.
# JEV_BROWSER_VIDEO_DIR=/data/laya-videos
